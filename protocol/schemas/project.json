{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaclip.dev/protocol/project.json",
  "title": "project 命名空间",
  "namespace": "project",
  "x-models": {
    "Project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_path",
        "status",
        "created_at",
        "episode_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "description": "来源类型：folder=整目录扫描，files=多选文件，mixed=目录项目又追加了外部文件。缺省 = 旧服务/旧数据，按 folder 处理"
        },
        "source_root": {
          "type": "string",
          "description": "来源展示根：目录项目=目录，文件项目=所选文件公共父目录（跨目录为空串，界面显示「多个位置」），mixed=原目录。缺省 = 旧服务未供数，回退 source_path"
        },
        "status": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "episode_count": {
          "type": "integer"
        },
        "analyzed_count": {
          "type": "integer",
          "description": "阶段聚合（09-10 §6 核心层）：分析落库（status=done）的集数；prescreened/analyzing/failed 不算。缺省 = 旧服务未供数，前端阶段灯按「宁灰勿假绿」降级"
        },
        "plan_count": {
          "type": "integer",
          "description": "阶段聚合：narration_plans 行数；缺省同上降级"
        },
        "analyzed_at": {
          "type": ["integer", "null"],
          "description": "过期对账（09-10 §3.1）：最近一次分析落库的服务毫秒（MAX(episodes.analyzed_at)）。NULL = 没分析过或迁移前旧数据——取不到 ≠ 不存在，前端金灯不点"
        },
        "last_episode_at": {
          "type": ["integer", "null"],
          "description": "过期对账：最近一次喂料的服务毫秒（MAX(episodes.created_at)）。晚于 analyzed_at = 加了素材还没重跑分析，① 进素材灯过期"
        },
        "latest_plan_at": {
          "type": ["integer", "null"],
          "description": "过期对账：最近一份方案快照的服务毫秒（MAX(narration_plans.created_at)）。早于 analyzed_at = 方案比转写旧，③ 规划灯过期"
        },
        "cover_path": {
          "type": ["string", "null"],
          "description": "NULL = 封面还没生成（补拍队列未跑到）；渲染层显示占位图，不请求 null 路径"
        },
        "settings": {
          "type": "object",
          "description": "项目级参数覆盖（方案数 K/转写档位/解说风格/字幕预设等）；空对象=全部使用全局默认。库内为 JSON 文本，仓储层解析后以对象返回（同 narration.PlanData.plan_data）"
        }
      }
    },
    "Episode": {
      "type": "object",
      "required": [
        "id",
        "episode_number",
        "name",
        "source_path",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "episode_number": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "cover_path": {
          "type": ["string", "null"],
          "description": "NULL = 集封面还没生成；渲染层显示占位图，不请求 null 路径"
        },
        "has_audio": {
          "type": ["boolean", "null"],
          "description": "ffprobe 音轨判定；null = 迁移前旧集尚未重扫（取不到 ≠ 没有，界面不发缺音轨告警）"
        }
      }
    },
    "ScannedEpisode": {
      "type": "object",
      "required": [
        "episode_number",
        "name",
        "source_path",
        "duration",
        "size_bytes",
        "has_audio"
      ],
      "properties": {
        "episode_number": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "size_bytes": {
          "type": "integer"
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "SkippedFile": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "用户所选的那条路径（原样回显，便于界面定位）"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing",
            "unreadable",
            "unsupported",
            "duplicate",
            "probe_failed"
          ],
          "description": "跳过原因：不存在/不可读/扩展名不支持/与已导入素材重复/探测失败（能打开但读不出媒体信息）"
        }
      }
    }
  },
  "x-methods": [
    {
      "name": "project.create",
      "summary": "创建项目（source_path 为剧集目录）",
      "params": {
        "type": "object",
        "required": [
          "name",
          "source_path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.create_from_files",
      "summary": "多选文件创建项目（只登记所选文件：不扫所在目录、不复制源文件；无效/重复计入 skipped）",
      "params": {
        "type": "object",
        "required": [
          "name",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "项目名（界面按公共父目录名预填；跨目录取第一个所选文件的父目录名）"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "用户多选的文件路径。不存在/不可读/扩展名不支持/重复选中/探测失败的文件跳过并计入 skipped；全部无效返回 -32103 且不建项目"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "project",
          "episodes",
          "skipped"
        ],
        "properties": {
          "project": {
            "$ref": "#/x-models/Project"
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/Episode"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/SkippedFile"
            }
          }
        }
      }
    },
    {
      "name": "project.list",
      "summary": "项目列表（含集数统计）",
      "params": {},
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/Project"
        }
      }
    },
    {
      "name": "project.get",
      "summary": "项目详情 + 集列表",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "project",
          "episodes"
        ],
        "properties": {
          "project": {
            "$ref": "#/x-models/Project"
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/Episode"
            }
          }
        }
      }
    },
    {
      "name": "project.delete",
      "summary": "删除项目（级联删集与分析结果）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "project.rename",
      "summary": "重命名项目",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "name"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.update_settings",
      "summary": "项目级参数覆盖（默认+覆盖机制的存储落点）；null 值=恢复该项默认",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "settings"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "description": "与现有覆盖集做键级合并；某键值为 null 表示删除该键",
            "additionalProperties": true
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "project_id",
          "settings"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "description": "合并后的完整项目级覆盖集"
          }
        }
      }
    },
    {
      "name": "project.duplicate",
      "summary": "复制项目元数据与集列表（分析结果不复制；settings 覆盖值带过去）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "$ref": "#/x-models/Project"
      }
    },
    {
      "name": "project.dashboard_summary",
      "summary": "工作台统计（项目数/集数/已分析集数/导出数）",
      "params": {},
      "result": {
        "type": "object",
        "required": [
          "project_count",
          "episode_count",
          "analyzed_episodes",
          "export_count"
        ],
        "properties": {
          "project_count": {
            "type": "integer"
          },
          "episode_count": {
            "type": "integer"
          },
          "analyzed_episodes": {
            "type": "integer"
          },
          "export_count": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "project.scan_episodes",
      "summary": "扫描项目目录登记集（ffprobe 逐文件时长/大小，返回登记结果）",
      "params": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/x-models/ScannedEpisode"
        }
      }
    },
    {
      "name": "project.add_episodes",
      "summary": "给既有项目追加素材（不替换、不重编号、不自动分析；分析/预筛进行中返回 -32105）",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "files"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "同 create_from_files 的校验口径；与项目已有素材（规范化绝对路径）重复的计入 skipped"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "added",
          "skipped",
          "episodes"
        ],
        "properties": {
          "added": {
            "type": "integer",
            "description": "本次新增集数（编号从追加前 MAX(episode_number)+1 起，既有集号与自定义名不变）"
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/SkippedFile"
            }
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/x-models/Episode"
            },
            "description": "仅本次新增的集（带新编号）；全部无效/重复时空数组且项目素材不变"
          }
        }
      }
    },
    {
      "name": "project.ensure_covers",
      "summary": "为缺封面的项目补截帧（幂等；单次有时间预算，欠账报 remaining）",
      "params": {
        "type": "object",
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "generated"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "generated": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer",
            "description": "预算收手后仍缺封面的条数（含死路径补不成的）。RPC dispatch 单线程，长堵会连 system.health 一起堵死触发误杀重启——故单次调用限 8 秒预算；>0 且本轮有进展时渲染层可再约一轮涓流补拍，无进展（全死路径）不值得无限重试"
          }
        }
      }
    },
    {
      "name": "project.reorder_episodes",
      "summary": "手动排序：按给定 episode_ids 顺序重编号（1..N）",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "episode_ids"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "episode_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  ]
}